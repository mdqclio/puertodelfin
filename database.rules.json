{
  "rules": {
    ".read": false,
    ".write": false,

    "clientes": {
      ".read": false,
      ".write": false,

      "puerto-delfin": {
        ".read": false,
        ".write": false,

        "mensajes": {
          ".read": false,
          ".write": false,

          "$convId": {
            ".read": "$convId.beginsWith('web__')",

            ".write": false,

            "$msgId": {
              ".validate": "newData.hasChildren(['rol', 'texto', 'ts'])",

              "rol": {
                ".validate": "newData.isString() && newData.val().length <= 32"
              },
              "texto": {
                ".validate": "newData.isString() && newData.val().length <= 8000"
              },
              "ts": {
                ".validate": "newData.isNumber()"
              },

              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    }
  }
}
